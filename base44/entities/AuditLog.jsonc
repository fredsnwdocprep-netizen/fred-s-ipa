{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "entity_type": {
      "type": "string",
      "description": "Type of entity affected"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of affected entity"
    },
    "entity_name": {
      "type": "string",
      "description": "Name snapshot"
    },
    "details": {
      "type": "string",
      "description": "JSON details"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "entity_type"
  ]
}