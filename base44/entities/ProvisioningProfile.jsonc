{
  "name": "ProvisioningProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Profile display name"
    },
    "team_id": {
      "type": "string",
      "description": "Apple Team ID"
    },
    "bundle_id": {
      "type": "string",
      "description": "Bundle identifier pattern"
    },
    "profile_uuid": {
      "type": "string",
      "description": "Profile UUID"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "development",
        "ad-hoc",
        "app-store"
      ],
      "default": "ad-hoc"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "expired"
      ],
      "default": "active"
    },
    "devices_count": {
      "type": "number",
      "description": "Number of registered devices"
    },
    "profile_uploaded": {
      "type": "boolean",
      "default": false
    },
    "encrypted_profile_uri": {
      "type": "string",
      "description": "Private storage URI"
    },
    "linked_certificate_id": {
      "type": "string",
      "description": "Associated signing certificate"
    }
  },
  "required": [
    "name",
    "bundle_id"
  ]
}